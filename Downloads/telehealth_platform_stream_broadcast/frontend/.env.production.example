# Copy to .env.production before `npm run build` (Vite embeds VITE_* at build time).
#
# AWS EC2 + Nginx (see deploy/aws/AWS-DEPLOYMENT.md):
#   Use relative same-origin URLs — no localhost, no raw IP in the bundle:
#   VITE_API_URL=
#   VITE_WS_URL=
#   Nginx proxies /api/ and /socket.io/ to Node on 127.0.0.1:3000
#
# Same-origin (Node also serves frontend/dist — backend server.js):
#   Leave empty; browser uses same host:port for /api and Socket.IO.
#
# Split deploy (static site + API on another host):
#   VITE_API_URL=https://your-api.example.com
#   VITE_WS_URL=https://your-api.example.com
VITE_API_URL=
VITE_WS_URL=
