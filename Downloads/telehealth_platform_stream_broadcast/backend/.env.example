# Server
PORT=3000
NODE_ENV=development
# EC2 + Nginx: bind API to localhost only (see deploy/aws/)
# HOST=127.0.0.1
# TRUST_PROXY=1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/telehealth

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES=7d

# LiveKit (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# CORS (comma-separated or * for all)
# Dev (Vite): http://localhost:5173
# Production split deploy: https://your-frontend.vercel.app
# Same-origin (Node serves frontend/dist): set to that same public URL
CORS_ORIGIN=http://localhost:5173

# Optional: absolute path to Vite build output when running `node server.js` from backend/
# Default: ../frontend/dist (repo layout). Docker/images: set to /app/static or similar.
# FRONTEND_DIST_PATH=
# EC2 + Nginx serves static: set SERVE_SPA=0 so only API/Socket.IO run on Node (no duplicate UI)
# SERVE_SPA=0

# YouTube Live / RTMP (browser → Node → FFmpeg → RTMP)
# Optional: defaults for admin panel. Can override in UI.
RTMP_SERVER_URL=rtmp://a.rtmp.youtube.com/live2
RTMP_STREAM_KEY=your-youtube-stream-key
